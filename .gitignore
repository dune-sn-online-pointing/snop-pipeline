# Python
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
dist/
build/

# Generated/runtime artifacts
analysis_outputs/
figures/
data/
results/
logs/
condor_logs/
outputs/
mcmc_visualization/
condor_recompute_optimized/
tests/

# Keep output folder tracked but ignore generated contents
output/*
!output/.gitkeep

# Logs
*.out
*.err
nohup.out
condor/*
!condor/.gitkeep

# IDE
.vscode/
.idea/

# Credentials
*.cc

# Large files
*.npz
*.root

# Keep only the canonical example JSON config tracked
json/*.json
!json/example_config.json