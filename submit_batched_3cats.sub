# HTCondor submit file for batched 3-cat emcee analysis (6 scenarios)
universe = vanilla
executable = /bin/bash
arguments = run_3cats_emcee_6scenarios.sh $(cat1) $(cat2) $(cat3)

# Transfer files - flatten directory structure
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = run_3cats_emcee_6scenarios.sh, scripts/run_cat_analysis_emcee_corrected.py, json/pipeline.json

# Remap transferred files to flat structure (script will recreate directories)
transfer_output_remaps = "run_cat_analysis_emcee_corrected.py=run_cat_analysis_emcee_corrected.py; pipeline.json=pipeline.json"

# Resource requirements - increased for 3 cats
request_cpus = 1
request_gpus = 1
request_memory = 32GB
request_disk = 8GB
+MaxRuntime = 43200

# Logs
log = logs/emcee_batch_$(cat1)_$(Cluster).log
output = logs/emcee_batch_$(cat1)_$(Cluster).out
error = logs/emcee_batch_$(cat1)_$(Cluster).err

# Queue for each batch (3 cats per job)
queue cat1,cat2,cat3 from cat_list_batched.txt
