# HTCondor submit file for SN analysis batch 20

universe              = vanilla
executable            = condor/test_parallel/wrapper_batch_020.sh

output                = condor/test_parallel/logs/batch_020_$(ClusterId).out
error                 = condor/test_parallel/logs/batch_020_$(ClusterId).err
log                   = condor/test_parallel/logs/batch_020_$(ClusterId).log

# GPU resources
request_gpus          = 1
request_cpus          = 4
request_memory        = 16GB
request_disk          = 4GB

# Job requirements
requirements          = (CUDADeviceName =?= "NVIDIA A100-SXM4-40GB") || \
                        (CUDADeviceName =?= "NVIDIA A100-PCIE-40GB") || \
                        (CUDADeviceName =?= "Tesla V100-SXM2-32GB") || \
                        (CUDADeviceName =?= "Tesla V100-PCIE-32GB")

+JobFlavour           = "longlunch"
environment           = "LCG_VIEW=/cvmfs/sft.cern.ch/lcg/views/LCG_106_cuda/x86_64-el9-gcc13-opt"

# No file transfer needed
should_transfer_files = NO

# Notification
notify_user           = evilla@cern.ch
notification          = Error

queue 1
