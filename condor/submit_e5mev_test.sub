executable = run_e5mev_10w_10ks.sh
output = condor_logs/emcee_e5mev_test_$(ClusterId)_$(ProcId).out
error = condor_logs/emcee_e5mev_test_$(ClusterId)_$(ProcId).err
log = condor_logs/emcee_e5mev_test_$(ClusterId)_$(ProcId).log

# Transfer files needed
transfer_input_files = scripts/run_cat_analysis_emcee_corrected.py, json/pipeline.json
transfer_output_files = ""
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# Resource requirements - NO GPU needed for perfect_ct scenarios
request_cpus = 1
request_memory = 8GB
+JobFlavour = "espresso"

# Submit to bigbird28 scheduler  
+AccountingGroup = "group_u_CMS.u_zh.users"

# Queue test jobs
arguments = $(categories)
queue categories from cat_batches_e5mev_test.txt
