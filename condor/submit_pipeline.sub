# Condor submit file for pipeline execution
# This is a template - actual values will be substituted by run_pipeline.py

executable              = /afs/cern.ch/work/e/evilla/private/dune/data-selection-pipeline/condor/run_pipeline_wrapper.sh
arguments               = $(cat_name) $(step) $(pipeline_args)
output                  = $(log_dir)/pipeline_$(step)_$(cat_name)_$(ClusterId).$(ProcId).out
error                   = $(log_dir)/pipeline_$(step)_$(cat_name)_$(ClusterId).$(ProcId).err
log                     = $(log_dir)/pipeline_$(step)_$(cat_name)_$(ClusterId).log

# Resource requests
request_cpus            = $(cpus)
request_memory          = $(memory)
request_disk            = $(disk)
request_gpus            = $(gpus)

# Job duration (espresso=20min, microcentury=1h, longlunch=2h, workday=8h, tomorrow=1d, testmatch=3d, nextweek=1w)
+JobFlavour             = "$(flavour)"

# GPU requirements (when gpus > 0)
+requirements           = $(gpu_requirements)

queue 1
