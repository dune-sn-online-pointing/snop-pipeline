# HTCondor submit file for resubmitting idle cats from cluster 13792804
universe = vanilla
executable = /bin/bash
arguments = run_single_cat_emcee_6scenarios.sh $(cat_name)

# Transfer files
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = run_single_cat_emcee_6scenarios.sh, scripts/run_cat_analysis_emcee_corrected.py, json/pipeline.json
transfer_output_remaps = "run_cat_analysis_emcee_corrected.py=run_cat_analysis_emcee_corrected.py"

# Resource requirements
request_cpus = 1
request_gpus = 1
request_memory = 32GB
request_disk = 4GB
+MaxRuntime = 14400

# Logs
log = logs/emcee_$(cat_name)_$(Cluster).log
output = logs/emcee_$(cat_name)_$(Cluster).out
error = logs/emcee_$(cat_name)_$(Cluster).err

# Queue for each cat from resubmit list
queue cat_name from cat_list_resubmit.txt
