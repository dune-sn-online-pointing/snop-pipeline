# Condor resubmission for failed cats 2-12 with longer timeout
executable = scripts/run_single_cat.sh
arguments = $(cat)

log = condor_logs/$(cat)_retry2.log
output = condor_logs/$(cat)_retry2.out
error = condor_logs/$(cat)_retry2.err

request_memory = 32GB
request_gpus = 1
+JobFlavour = "tomorrow"

queue cat from (
cat000002
cat000003
cat000004
cat000005
cat000006
cat000007
cat000008
cat000009
cat000010
cat000011
cat000012
)
